DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
JWT_SECRET="generate with: openssl rand -base64 32"
PORT=3009
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
# true = skip real Claude calls (question generation + scoring) and return canned responses
MOCK_AI=true
# true = skip the real Groq Whisper call and return a canned transcript.
# Separate from MOCK_AI so you can test voice for real while scoring stays free.
MOCK_TRANSCRIPTION=false
