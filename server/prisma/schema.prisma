generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) — used at runtime
  directUrl = env("DIRECT_URL") // direct connection — used by migrations
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescription String?
  status         String     @default("draft")
  createdAt      DateTime   @default(now())
  questions      Question[]
}

model Question {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tier      String // 'warmup' | 'behavioral' | 'technical'
  text      String
  order     Int
  createdAt DateTime @default(now())
  answers   Answer[] // 一对多 一个question可以有多个answer
  resumeBased Boolean @default(false)
  
  @@unique([sessionId, text]) 
  //- @(一个)= 字段级属性 → 写在某个字段那一行(如 id String @id)。- @@(两个)= 模型级属性 → 写在自己单独一行(模型块内,通常放最下面)。当属性跨多个字段时用(比如这里 [sessionId, text] 是两个字段的组合唯一)。所以 @@index、@@unique、@@map 这些"双 @"的,都是独立成行、放模型底部。
}

model Answer {
  id          String       @id @default(cuid()) //primary key
  questionId  String // foreign key
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime     @default(now())
  scoreReport ScoreReport? // 反向关系:一个 answer 最多一份报告(? = 可能还没评分)
}

model ScoreReport {
  id                 String   @id @default(cuid()) //primary key
  answerId           String   @unique // foreign key
  answer             Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  contentScore       Int
  languageScore      Int
  deliveryScore      Int
  contentContext     String
  languageContext    String
  deliveryContext    String
  languageErrorList  Json
  polishedVersion    String
  structuralExemplar String
  createdAt          DateTime @default(now())
}
